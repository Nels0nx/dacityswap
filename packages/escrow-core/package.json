{
  "name": "@dacityswap/escrow-core",
  "version": "0.2.0",
  "description": "The escrow state machine, fee engine and settlement maths behind DacitySwap. Pure, dependency-free TypeScript.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "vectors",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "escrow",
    "marketplace",
    "state-machine",
    "fees",
    "payments",
    "settlement"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nels0nx/dacityswap.git",
    "directory": "packages/escrow-core"
  },
  "homepage": "https://docs.dacityswap.com",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
